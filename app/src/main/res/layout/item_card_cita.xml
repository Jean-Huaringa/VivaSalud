<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border"
        android:padding="10dp">

        <!-- Contenido principal -->
        <LinearLayout
            android:id="@+id/contenidoCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Centro clinico la molina - medicina interna"
                android:textColor="@color/dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/name_doctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Salazar Moreno, Jose Carlos"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ubication"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Centro clinico la molina"
                android:textColor="@color/dark"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/name_paciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nicole Geraldine Leon Aguilar"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/iconosAccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Eliminar"
                app:tint="@color/red"
                />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>